-- CRIANDO A TABELA CLIENTES
CREATE TABLE clientes (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    email VARCHAR(100),
    cpf VARCHAR(14),
    telefone VARCHAR(20)
);

-- CRIANDO A TABELA PEDIDOS
CREATE TABLE pedidos (
    id INT PRIMARY KEY,
    produto VARCHAR(100),
    valor DECIMAL(10,2),
    idclientes INT,

    FOREIGN KEY (idclientes) REFERENCES clientes(id)
);


