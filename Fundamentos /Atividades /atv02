DROP DATABASE IF EXISTS clientes;

CREATE DATABASE clientes;

USE clientes;

CREATE TABLE clientes (
    idcliente INT PRIMARY KEY,
    nome VARCHAR(100),
    email VARCHAR(100),
    cpf INT
);

