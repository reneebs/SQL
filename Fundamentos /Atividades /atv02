CREATE TABLE pedidos (
    idpedidos INT PRIMARY KEY,
    idcliente INT,
    data_pedido DATE,
    valor_total DECIMAL(10,2),
    FOREIGN KEY (idcliente) REFERENCES clientes(idcliente)
);

