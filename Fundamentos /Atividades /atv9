SELECT l.nome, li.titulo, e.data_emprestimo
FROM emprestimos e
INNER JOIN leitores l ON e.id_leitor = l.id_leitor
INNER JOIN livros li ON e.id_livro = li.id_livro;

SELECT l.nome, li.titulo
FROM leitores l
LEFT JOIN emprestimos e ON l.id_leitor = e.id_leitor
LEFT JOIN livros li ON e.id_livro = li.id_livro;

SELECT l.nome, li.titulo, e.data_prevista
FROM emprestimos e
INNER JOIN leitores l ON e.id_leitor = l.id_leitor
INNER JOIN livros li ON e.id_livro = li.id_livro
WHERE e.data_devolucao IS NULL;
