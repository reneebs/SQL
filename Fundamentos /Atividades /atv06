CREATE TABLE brinquedos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    categoria VARCHAR(50) NOT NULL,
    preco DECIMAL(10,2) CHECK (preco > 0),
    quantidade_estoque INT DEFAULT 0
);

