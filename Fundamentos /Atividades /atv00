DROP DATABASE IF exists PRODUTORA;

CREATE DATABASE PRODUTORA;

USE PRODUTORA;

CREATE TABLE raça(
	id_animal INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100),
    especie VARCHAR(50),
    idade INT
);
