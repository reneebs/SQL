SELECT cidade.nome, estado.nome
FROM cidade
INNER JOIN estado
ON cidade.id_Estado = estado.id_Estado;

SELECT endereco.bairro, cidade.nome, estado.nome
FROM endereco
INNER JOIN cidade
ON endereco.id_Cidade = cidade.id_Cidade
INNER JOIN estado
ON cidade.id_Estado = estado.id_Estado;
