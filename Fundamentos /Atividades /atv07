CREATE TABLE estado (
    id_Estado INT PRIMARY KEY,
    nome VARCHAR(50)
);

CREATE TABLE cidade (
    id_Cidade INT PRIMARY KEY,
    nome VARCHAR(50),
    id_Estado INT,
    FOREIGN KEY (id_Estado) REFERENCES estado(id_Estado)
);

CREATE TABLE endereco (
    id_Endereco INT PRIMARY KEY,
    bairro VARCHAR(50),
    id_Cidade INT,
    FOREIGN KEY (id_Cidade) REFERENCES cidade(id_Cidade)
);

